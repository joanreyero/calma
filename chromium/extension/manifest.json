{
  "manifest_version": 3,
  "name": "Calma",
  "version": "0.1.0",
  "description": "Minimal versions of distracting sites, a calm blocked page and a session countdown. Companion to the Calma daemon.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "webNavigation",
    "declarativeNetRequest",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:7390/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.youtube-nocookie.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Calma"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/countdown.js"],
      "css": ["content/countdown.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "js": ["content/x.js"],
      "css": ["content/x.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtu.be/*"],
      "js": ["content/youtube.js"],
      "css": ["content/youtube.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
