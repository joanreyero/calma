[Unit]
Description=Calma distraction blocker daemon
Documentation=https://github.com/joanreyero/calma
After=network.target
StartLimitIntervalSec=0
# Loosening Calma needs the password; stopping the daemon is not a shortcut.
RefuseManualStop=yes

[Service]
Type=simple
ExecStart=/usr/lib/calma/calmad
Restart=always
RestartSec=1
KillMode=process
RuntimeDirectory=calma
StateDirectory=calma
ConfigurationDirectory=calma
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
